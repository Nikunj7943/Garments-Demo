{
  "doctype": "DocType",
  "name": "Cutting Order",
  "module": "Garment Demo",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "options": "CUT-.YYYY.-", "default": "CUT-.YYYY.-", "label": "Series"},
    {"fieldname": "style", "fieldtype": "Link", "options": "Garment Style", "label": "Style", "reqd": 1, "in_list_view": 1},
    {"fieldname": "fabric_lot_no", "fieldtype": "Data", "label": "Fabric Lot No"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "order_qty", "fieldtype": "Int", "label": "Order Qty (pcs)", "reqd": 1, "in_list_view": 1},
    {"fieldname": "cutting_date", "fieldtype": "Date", "label": "Cutting Date", "default": "Today"},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Cutting Output"},
    {"fieldname": "fabric_consumed_meters", "fieldtype": "Float", "label": "Fabric Consumed (m)"},
    {"fieldname": "panels_cut_qty", "fieldtype": "Int", "label": "Panels Cut (pcs)"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "fabric_wastage_pct", "fieldtype": "Percent", "label": "Fabric Wastage %", "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "default": "Draft",
      "options": "Draft\nCutting In Progress\nCut Complete\nSent to Stitching", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Manufacturing User", "read": 1, "write": 1, "create": 1, "submit": 1}
  ]
}
