{
  "doctype": "DocType",
  "name": "QC Inspection",
  "module": "Garment Demo",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "options": "QC-.YYYY.-", "default": "QC-.YYYY.-", "label": "Series"},
    {"fieldname": "stitching_line_entry", "fieldtype": "Link", "options": "Stitching Line Entry", "label": "Stitching Line Entry", "reqd": 1},
    {"fieldname": "style", "fieldtype": "Link", "options": "Garment Style", "label": "Style", "fetch_from": "stitching_line_entry.style", "read_only": 1, "in_list_view": 1},
    {"fieldname": "inspection_stage", "fieldtype": "Select", "label": "Inspection Stage", "reqd": 1, "in_list_view": 1,
      "options": "Inline\nEndline\nFinal (Pre-Shipment)"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "aql_level", "fieldtype": "Select", "label": "AQL Level", "default": "2.5",
      "options": "1.0\n1.5\n2.5\n4.0", "description": "Acceptable Quality Level per ANSI/ASQ Z1.4"},
    {"fieldname": "lot_size", "fieldtype": "Int", "label": "Lot Size Inspected"},
    {"fieldname": "sample_size", "fieldtype": "Int", "label": "Sample Size"},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Defects Found"},
    {"fieldname": "defects", "fieldtype": "Table", "options": "QC Defect Entry", "label": "Defects"},
    {"fieldname": "section_break_2", "fieldtype": "Section Break", "label": "Result"},
    {"fieldname": "total_defect_qty", "fieldtype": "Int", "label": "Total Defect Qty", "read_only": 1},
    {"fieldname": "defect_rate_pct", "fieldtype": "Percent", "label": "Defect Rate %", "read_only": 1},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "result", "fieldtype": "Select", "label": "Result", "default": "Under Inspection", "in_list_view": 1,
      "options": "Under Inspection\nPassed\nFailed - Rework Required\nFailed - Reject"},
    {"fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Workflow State", "hidden": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Quality Manager", "read": 1, "write": 1, "create": 1, "submit": 1}
  ]
}
