{
  "doctype": "DocType",
  "name": "Garment Style",
  "module": "Garment Demo",
  "custom": 0,
  "naming_rule": "By fieldname",
  "autoname": "field:style_code",
  "title_field": "style_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {"fieldname": "style_code", "fieldtype": "Data", "label": "Style Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "style_name", "fieldtype": "Data", "label": "Style Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "buyer", "fieldtype": "Link", "options": "Customer", "label": "Buyer", "reqd": 1, "in_list_view": 1},
    {"fieldname": "season", "fieldtype": "Data", "label": "Season (e.g. SS26, FW26)"},
    {"fieldname": "garment_category", "fieldtype": "Select", "label": "Category",
      "options": "Woven Top\nWoven Bottom\nKnit Top\nKnit Bottom\nOuterwear\nDenim\nActivewear"},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Production Reference"},
    {"fieldname": "item_code", "fieldtype": "Link", "options": "Item", "label": "Linked Item (Finished Good)"},
    {"fieldname": "bom", "fieldtype": "Link", "options": "BOM", "label": "Linked BOM"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "target_smv", "fieldtype": "Float", "label": "Target SMV (Standard Minute Value)",
      "description": "Standard time (minutes) to produce one garment, used for line efficiency calculations"},
    {"fieldname": "size_run", "fieldtype": "Small Text", "label": "Size Run (e.g. XS-XXL)"},
    {"fieldname": "section_break_2", "fieldtype": "Section Break", "label": "Size Chart / Ratio"},
    {"fieldname": "size_ratio", "fieldtype": "Table", "options": "Garment Style Size Ratio", "label": "Size Ratio"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 0},
    {"role": "Manufacturing Manager", "read": 1, "write": 1, "create": 1}
  ]
}
