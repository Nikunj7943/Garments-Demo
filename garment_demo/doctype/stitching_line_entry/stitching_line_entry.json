{
  "doctype": "DocType",
  "name": "Stitching Line Entry",
  "module": "Garment Demo",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "options": "SLE-.YYYY.-", "default": "SLE-.YYYY.-", "label": "Series"},
    {"fieldname": "cutting_order", "fieldtype": "Link", "options": "Cutting Order", "label": "Cutting Order", "reqd": 1},
    {"fieldname": "style", "fieldtype": "Link", "options": "Garment Style", "label": "Style", "fetch_from": "cutting_order.style", "read_only": 1, "in_list_view": 1},
    {"fieldname": "line_no", "fieldtype": "Data", "label": "Production Line", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "shift_date", "fieldtype": "Date", "label": "Date", "default": "Today", "in_list_view": 1},
    {"fieldname": "operators_on_line", "fieldtype": "Int", "label": "Operators on Line"},
    {"fieldname": "shift_hours", "fieldtype": "Float", "label": "Shift Hours", "default": 8},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Hourly Production"},
    {"fieldname": "hourly_output", "fieldtype": "Table", "options": "Stitching Hourly Output", "label": "Hourly Output Log"},
    {"fieldname": "section_break_2", "fieldtype": "Section Break", "label": "Line Performance"},
    {"fieldname": "total_output_pcs", "fieldtype": "Int", "label": "Total Output (pcs)", "read_only": 1},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "line_efficiency_pct", "fieldtype": "Percent", "label": "Line Efficiency %", "read_only": 1,
      "description": "(Output x Target SMV) / (Operators x Shift Minutes) x 100"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Manufacturing User", "read": 1, "write": 1, "create": 1}
  ]
}
